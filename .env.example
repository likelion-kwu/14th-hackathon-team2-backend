# Docker image and published HTTP endpoint
APP_VERSION=0.0.2-SNAPSHOT
# CI supplies BACKEND_IMAGE when deploying a prebuilt image. Leave it unset for local builds.
# BACKEND_IMAGE=godsaeng-lion-backend:git-sha-run-attempt
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# PostgreSQL container. Replace the example password before starting the stack.
POSTGRES_DB=godsaeng_lion
POSTGRES_USER=godsaeng
POSTGRES_PASSWORD=replace-with-a-strong-password

# Persistent host directory for generated Avatar Stage PNG files.
# On the Gabia VM, use /var/lib/godsaengsaja/avatars.
AVATAR_HOST_PATH=./data/avatars

# Optional AI configuration. Empty OPENAI_API_KEY keeps non-AI fallback paths available.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_RESPONSES_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
